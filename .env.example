# Mail domain / hostname
EMAIL_HOSTNAME=mail.example.com
WEBSITE_DOMAIN=example.com

# SMTP2GO smarthost - outbound relay. Host:port as Postfix expects it for
# relayhost, e.g. [mail.smtp2go.com]:2525
EMAIL_RELAY_HOST=[mail.smtp2go.com]:2525
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
# Production defaults - SMTP2GO requires auth + TLS. docker-compose.test.yml
# overrides both to "no"/"none" for the local Mailpit relay.
SMTP_SASL_AUTH_ENABLE=yes
SMTP_TLS_SECURITY_LEVEL=encrypt

# The existing project's Postgres instance (shared with the webserver) -
# not a dedicated DB container in this project. Fill in with whatever is
# already configured for that project in Dokploy. The webserver manages
# the alias table directly; Postfix only ever reads it.
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Credential the webserver authenticates with to submit outbound mail to
# postfix (SASL PLAIN/LOGIN) - not network/CIDR-based, since dokploy-network
# is shared with other things in the same Dokploy project that shouldn't
# get relay access just by being on that subnet. Generated into postfix's
# sasldb2 at container startup, not baked into the image.
SUBMISSION_USERNAME=
SUBMISSION_PASSWORD=

GRAFANA_ADMIN_PASSWORD=
