# Env file for docker-compose.test.yml - used with:
#   docker compose -f docker-compose.test.yml --env-file .env.test up --build
#
# The relay itself (EMAIL_RELAY_HOST, SMTP_RELAY_*, SMTP_SASL_AUTH_ENABLE,
# SMTP_TLS_SECURITY_LEVEL) is hardcoded to Mailpit directly in
# docker-compose.test.yml, so it's not needed here - only the vars that
# file doesn't already override.

EMAIL_HOSTNAME=mail.example.com
WEBSITE_DOMAIN=example.com

# No Postgres container in this project (see README) - point these at a
# throwaway local one if you want alias lookups to actually resolve
# instead of temp-failing (451), e.g.:
#   docker run -d --name test-postgres --network dokploy-network \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=postgres postgres:16-alpine
# then create a mail_aliases table matching containers/postfix/pgsql-aliases.cf.tmpl's
# query and insert a row to test against.
POSTGRES_HOST=test-postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Credential a test client authenticates with (AUTH PLAIN/LOGIN) to submit
# mail through postfix - mynetworks is loopback-only now, so an
# unauthenticated client gets "Relay access denied" for anything outside
# our own domain. See the "Testing with Mailpit" section in README for a
# worked AUTH example.
SUBMISSION_USERNAME=test
SUBMISSION_PASSWORD=test

GRAFANA_ADMIN_PASSWORD=test
