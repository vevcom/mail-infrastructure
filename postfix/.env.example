# The mail domain - aliases are <something>@<domain>. One per deployment:
# the test domain for the test app, omega.ntnu.no for prod. See README.
WEBSITE_DOMAIN=example.com

# The mail host: the name postfix introduces itself with, and a second
# domain it receives alias mail for. Same value as the website's
# EMAIL_HOSTNAME (prod: sanctus.omega.ntnu.no). Empty = mail.<domain>.
EMAIL_HOSTNAME=

# How outbound mail leaves this server - see README "Delivery modes":
#   relay  - through EMAIL_RELAY_HOST (NTNU's mailgw), like the old omegaweb
#            postfix. Only works from a host on NTNU's network.
#   direct - straight to each recipient's mail server, with SRS + DKIM.
#            Needs outbound port 25 open and the DNS records in DNS.md.
DELIVERY_MODE=relay

# ---- relay mode only (ignored in direct mode) -----------------------------
# NTNU's mail gateway relays by source IP (no auth) - so this only works if
# this host is on NTNU's network (129.241.0.0/16).
#
# Don't swap in a sending service like SMTP2GO here: forwarded mail keeps
# the original sender (e.g. someone@gmail.com), and those services only
# relay mail from domains you've verified with them.
EMAIL_RELAY_HOST=mailgw.ntnu.no
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
SMTP_SASL_AUTH_ENABLE=no
SMTP_TLS_SECURITY_LEVEL=may

# ---- direct mode only (ignored in relay mode) -----------------------------
# DKIM selector: the key is published at <selector>._domainkey.<domain>.
# The key is generated on first start and its DNS record printed to the
# logs (see DNS.md). Change the selector only to rotate the key.
DKIM_SELECTOR=mail

# ---- both modes -----------------------------------------------------------
# The website's Postgres (the alias tables live there) - not a dedicated DB
# container in this project. Same host/credentials as the website's DB_URI.
# The webserver manages the alias tables; Postfix only ever reads them.
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Credential the website authenticates with to submit its own mail to
# postfix (SASL PLAIN/LOGIN) - used in direct mode, see README. Not
# network/CIDR-based, since dokploy-network is shared with other things that
# shouldn't get relay access just by being on that subnet. Generated into
# postfix's sasldb2 at container startup, not baked into the image.
SUBMISSION_USERNAME=
SUBMISSION_PASSWORD=

GRAFANA_ADMIN_PASSWORD=
