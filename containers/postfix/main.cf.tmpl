# See /usr/share/postfix/main.cf.dist for a commented, more complete version

# The hostname of the machine - EMAIL_HOSTNAME, default mail.<WEBSITE_DOMAIN>
# (see entrypoint.sh). Mail to @<this name> is ours too (mydestination). Also the HELO name, so it should match the PTR (DNS.md).
myhostname = {{ .Env.EMAIL_HOSTNAME }}

# Debian specific:  Specifying a file name will cause the first
# line of that file to be used as the name.  The Debian default
# is /etc/mailname.
#myorigin = /etc/mailname
# This is used for mail sendt from postfix
myorigin = $myhostname

smtpd_banner = $myhostname ESMTP $mail_name
biff = no

# appending .domain is the MUA's job.
append_dot_mydomain = no

readme_directory = no

# See http://www.postfix.org/COMPATIBILITY_README.html -- default to 2 on
# fresh installs.
compatibility_level = 2

# TLS parameters - opportunistic STARTTLS. This instance receives the
# domain's mail (directly as its MX, or via NTNU's MX - see DNS.md), so it
# offers encryption on the public-facing side. The cert is self-signed (see
# Dockerfile) and is never validated by connecting clients - "may" means
# Postfix encrypts the hop when the other side supports STARTTLS, but never
# requires or checks a CA-trusted chain.
smtpd_tls_cert_file = /etc/postfix/tls.crt
smtpd_tls_key_file = /etc/postfix/tls.key
smtpd_tls_security_level = may
smtpd_tls_auth_only = no

# SASL for the webserver's submission to this container (replaces trusting
# it by network/CIDR - see README for why). The credential is a single
# fixed user/pass pair generated at container startup (see Dockerfile),
# not baked into the image or managed via a lookup table.
smtpd_sasl_auth_enable = yes
smtpd_sasl_type = cyrus
smtpd_sasl_path = smtpd
smtpd_sasl_security_options = noanonymous

# Anti-open-relay: only mynetworks (now just loopback) or an authenticated
# client may relay mail to a domain we don't own. This has no effect on
# receiving mail FOR our own domain (mydestination) - anonymous internet
# senders can still deliver to our aliases; this only blocks using us to
# forward mail onward without a credential.
smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination

# The domain of the mails
mydomain = {{ .Env.WEBSITE_DOMAIN }}

# Local/alias(5) lookups for addresses in mydestination (see below)
alias_maps = pgsql:/etc/postfix/pgsql-aliases.cf
alias_database = pgsql:/etc/postfix/pgsql-aliases.cf

# This is the important pointer that makes mail get forwarded. The
# webserver only ever sends mail (and manages this table directly in
# Postgres) - it never receives any, so there's no case here for routing
# matched addresses anywhere but out through the relay below.
virtual_alias_maps = pgsql:/etc/postfix/pgsql-aliases.cf

{{ if eq .Env.DELIVERY_MODE "direct" }}
# ---------------------------------------------------------------------------
# DELIVERY_MODE=direct - no relay: postfix looks up each recipient domain's MX
# and delivers there itself. Needs outbound port 25, a PTR record and SPF/
# DKIM/DMARC in DNS - see DNS.md.
# ---------------------------------------------------------------------------
relayhost =
smtp_tls_security_level = may

# Docker's bridge network has no IPv6 route, and Gmail also wants a PTR for
# IPv6 senders - so don't try IPv6 MX hosts at all.
inet_protocols = ipv4

# SRS via postsrsd (see postsrsd.conf.tmpl): forwarded mail from e.g.
# someone@gmail.com leaves with envelope sender SRS0=...@<domain> so SPF
# passes; bounces to those addresses are rewritten back to the original.
sender_canonical_maps = socketmap:inet:127.0.0.1:10003:forward
sender_canonical_classes = envelope_sender
recipient_canonical_maps = socketmap:inet:127.0.0.1:10003:reverse
recipient_canonical_classes = envelope_recipient, header_recipient

# DKIM signing via opendkim (see opendkim.conf) for mail From our own
# domain: the website's submissions and our own bounces. If opendkim is
# down, mail waits in the queue instead of going out unsigned.
smtpd_milters = inet:127.0.0.1:8891
non_smtpd_milters = $smtpd_milters
milter_default_action = tempfail

# Light inbound checks. In direct mode the MX points straight here, with no
# NTNU spam filter in front - and every spam we accept for an alias gets
# forwarded from our IP, hurting its reputation. The website (SASL) and
# loopback skip all of it.
smtpd_helo_required = yes
smtpd_helo_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_invalid_helo_hostname,
    reject_non_fqdn_helo_hostname
# Nobody but the website may send as our own domain - otherwise anyone could
# send "from" noreply@<domain> to an alias, and we'd forward it from an IP
# that <domain>'s SPF allows.
smtpd_sender_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    check_sender_access inline:{ { {{ .Env.WEBSITE_DOMAIN }} = REJECT Not authenticated to send as this domain } },
    reject_non_fqdn_sender,
    reject_unknown_sender_domain
# Spamhaus ZEN blocklist. The reply-code filter matters: when queried
# through a big public resolver (8.8.8.8, 1.1.1.1, ...) Spamhaus answers
# 127.255.255.254 for everything, which would otherwise reject all mail.
# The server should use its own/the ISP's resolver for this to do anything.
smtpd_recipient_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_rbl_client zen.spamhaus.org=127.0.0.[2..11]
disable_vrfy_command = yes
{{ else }}
# ---------------------------------------------------------------------------
# DELIVERY_MODE=relay - all outbound mail (including whatever the webserver
# submits to this container) goes out through the relay as a smarthost.
# NTNU's mailgw in production (no auth, relays by source IP - same as the
# old omegaweb postfix); swapped for a local Mailpit container in
# docker-compose.test.yml (see README) without touching this file.
# ---------------------------------------------------------------------------
relayhost = {{ .Env.EMAIL_RELAY_HOST }}
smtp_sasl_auth_enable = {{ .Env.SMTP_SASL_AUTH_ENABLE }}
smtp_sasl_security_options = noanonymous
smtp_sasl_password_maps = static:{{ .Env.SMTP_RELAY_USERNAME }}:{{ .Env.SMTP_RELAY_PASSWORD }}
smtp_tls_security_level = {{ .Env.SMTP_TLS_SECURITY_LEVEL }}
inet_protocols = all
{{ end }}

# Writes straight to a file instead of syslog, so postfix-exporter can tail
# it without needing access to the Docker socket. Rotated by cron/logrotate
# (see Dockerfile + logrotate.conf) - this file has no built-in rotation.
maillog_file = /var/log/postfix/maillog

# Default settings
mailbox_size_limit = 0
recipient_delimiter = +
inet_interfaces = all

# Domains that are not forwarded
mydestination = $mydomain $myhostname localhost.$myhostname localhost

# Loopback only - the webserver authenticates via SASL instead of being
# trusted by network/CIDR (see smtpd_relay_restrictions above and the
# README). Nothing else on the shared Dokploy network gets relay access
# just by being on the same subnet.
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128
